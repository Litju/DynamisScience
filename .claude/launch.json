{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "science",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "services/science",
        "uvicorn",
        "dynamis_science.api:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dynamis/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dynamis/web",
        "start"
      ],
      "port": 3000
    }
  ]
}
